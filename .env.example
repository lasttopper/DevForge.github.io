# =====================================================================
#  Omnichannel AI Sales Machine — n8n environment variables
#
#  Copy these into your n8n instance's environment, then RESTART n8n.
#  Every workflow reads them through its "⚙️ Config" node — that node is
#  the only place configuration lives, nothing is hardcoded deeper in.
#
#  On n8n 2.0+ self-hosted you also need:
#      N8N_BLOCK_ENV_ACCESS_IN_NODE=false
#  ...otherwise $env is blocked inside Code nodes.
#
#  On n8n Cloud, custom env vars aren't available: open the ⚙️ Config
#  node in each of the four workflows and type the values in directly.
#  See docs/IMPORT.md step 4.
# =====================================================================

# --- Supabase --------------------------------------------------------
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
# The service_role key goes in the n8n "Supabase API" credential,
# not here — it must never sit in a plain env file you might commit.

# --- WhatsApp (Evolution API on Railway) -----------------------------
EVOLUTION_API_URL=https://your-evolution.up.railway.app
EVOLUTION_INSTANCE=sales-bot
# The apikey goes in the n8n "Header Auth" credential named Evolution.

# --- n8n itself ------------------------------------------------------
# Public base URL, used to trigger workflow 3 from workflow 2.
N8N_WEBHOOK_BASE=https://your-n8n.example.com

# --- Your identity ---------------------------------------------------
SENDER_EMAIL=you@yourdomain.com
SENDER_NAME=Alex
AGENCY_NAME=Studio Nova
PUBLIC_SITE_URL=https://your-agency.example.com
DEFAULT_COUNTRY_CODE=91

# --- AI models (OpenRouter slugs) ------------------------------------
# Any model on https://openrouter.ai/models — ":free" slugs cost nothing
# but are rate-limited. Upgrade the CODER one first if HTML gets truncated.
OPENROUTER_MODEL_COPY=nousresearch/hermes-3-llama-3.1-405b:free
OPENROUTER_MODEL_TRIAGE=meta-llama/llama-3.3-70b-instruct:free
OPENROUTER_MODEL_CODER=deepseek/deepseek-chat-v3-0324:free

# --- Lead discovery --------------------------------------------------
APIFY_MAX_PLACES=20          # places per search (watch your $5 credit)
SEARCHES_PER_RUN=1           # niche/city pairs per execution
MAX_NEW_LEADS_PER_RUN=10     # hard cap on messages per execution

# --- Commercials -----------------------------------------------------
OFFER_PRICE_PAISE=150000     # IN PAISE. 150000 = INR 1,500
OFFER_CURRENCY=INR

# --- Razorpay --------------------------------------------------------
# Key ID / Secret go in the n8n "Basic Auth" credential named Razorpay.
# This one must match the secret you set on the webhook in the dashboard:
RAZORPAY_WEBHOOK_SECRET=whsec_replace_me

# --- Safety ----------------------------------------------------------
DRY_RUN=true                 # true = build the copy, send nothing. START HERE.
WHATSAPP_DAILY_CAP=40        # keep low on a new number or you'll get banned
BUILD_MODE=auto              # auto = AI builds the paid site; manual = you do

# --- Optional --------------------------------------------------------
# Slack or Discord incoming webhook — pinged when a payment lands.
ALERT_WEBHOOK_URL=
