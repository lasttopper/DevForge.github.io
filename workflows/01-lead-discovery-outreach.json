      "id": "468b5c31-3331-4e45-a29b-80ad14ea28f6",
      "name": "💾 Upsert Lead + Contact",
      "onError": "continueRegularOutput"
    },
    {
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "// The RPC returns a single-row table -> unwrap it, drop anything we have\n// already contacted before, and drop rows where the RPC errored.\nconst out = [];\nfor (const item of $input.all()) {\n  const row = Array.isArray(item.json) ? item.json[0] : (item.json?.[0] ?? item.json);\n  if (!row || !row.lead_id) continue;\n  if (row.is_new === false) continue;      // already in the pipeline\n  out.push({ json: row });\n}\nreturn out;"
      },
