        "duplicateItem": false,
        "assignments": {
          "assignments": [
            {
              "id": "dcdbee8d-1a12-42b0-92e1-ec5b7a36bf73",
              "name": "system_prompt",
              "value": "=You are a precise sales-reply classifier. You reply with exactly one word from the allowed list and nothing else. No punctuation, no explanation.",
              "type": "string"
            },
            {
              "id": "cb83d500-f5d5-46d7-ba6a-d6bfd93e5ebb",
              "name": "prompt",
              "value": "=A local business owner replied to my cold outreach.\n\nContext:\n- Business: {{ $('🧩 Attach Lead Context').item.json.business_name }}\n- Where we are in the conversation: {{ $('🧩 Attach Lead Context').item.json.lead_status }}\n- I already sent them a free mockup: {{ $('🧩 Attach Lead Context').item.json.awaiting_approval ? 'YES — ' + $('🧩 Attach Lead Context').item.json.prototype_url : 'no' }}\n\nTheir reply:\n\"\"\"\n{{ $('🧩 Attach Lead Context').item.json.body }}\n\"\"\"\n\nClassify into exactly one of:\nINTERESTED   - wants the free mockup / says yes / asks me to send it\nAPPROVED     - they have SEEN the mockup and like it, or ask about price/how to pay/next steps\nQUESTION     - genuine question or hesitation, not yet a yes\nNOT_INTERESTED - no, stop, remove me, unsubscribe, angry, or already has a site\nAUTO_REPLY   - out-of-office, delivery failure, or an automated system message\n\nAnswer with one word only.",
              "type": "string"
            }
          ]
        },
        "includeOtherFields": false,
        "options": {}
