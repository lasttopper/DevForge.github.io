    },
    {
      "parameters": {
        "mode": "manual",
        "duplicateItem": false,
        "assignments": {
          "assignments": [
            {
              "id": "19c463bd-6a65-40e4-a324-8d02267946ab",
              "name": "system_prompt",
              "value": "=You are a senior front-end developer. You output a single complete HTML document and absolutely nothing else — no markdown fences, no commentary before or after.",
              "type": "string"
            },
            {
              "id": "28e428e0-4d41-4231-912e-e25e523f4f43",
              "name": "prompt",
              "value": "=Build a one-page marketing website for this real local business.\n\nBusiness: {{ $json.business_name }}\nIndustry: {{ $json.niche }}\nCity: {{ $json.location }}\nPhone: {{ $json.phone }}\nAddress: {{ $json.metadata?.address || $json.location }}\nGoogle rating: {{ $json.metadata?.rating || 'n/a' }} from {{ $json.metadata?.reviews || 0 }} reviews\n\nRequirements:\n- Single self-contained index.html. Tailwind via <script src=\"https://cdn.tailwindcss.com\"></script>.\n- Sections: sticky nav, hero with a strong headline + \"Call now\" button (tel: link to the phone above), 3-4 services cards relevant to a {{ $json.niche }}, why-choose-us with the Google rating if present, testimonials (mark them clearly as sample text), contact section with phone/address and a simple form (no backend, just markup), footer.\n- Real, specific copy for a {{ $json.niche }} in {{ $json.location }}. No lorem ipsum. No placeholder like [Business Name].\n- Modern look: one accent colour that suits the industry, generous whitespace, rounded cards, subtle shadows, mobile-first responsive.\n- Use inline SVG icons or emoji — never link to image files that don't exist.\n- Include <title> and a meta description with the business name and city.\n- No external JS besides the Tailwind CDN.\n\nOutput the raw HTML document starting with <!DOCTYPE html>.",
              "type": "string"
            }
          ]
        },
        "includeOtherFields": false,
        "options": {}
      },
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        1400,
        -220
      ],
      "id": "ce0502e1-b627-4cb3-b352-67d111536856",
      "name": "🎨 Build Site Prompt"
    },
    {
      "parameters": {
        "method": "POST",
        "options": {
          "timeout": 180000,
          "response": {
            "response": {
              "neverError": false
            }
          }
        },
        "url": "https://openrouter.ai/api/v1/chat/completions",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Content-Type",
              "value": "application/json"
            },
            {
              "name": "HTTP-Referer",
              "value": "={{ $('⚙️ Config').first().json.public_site_url }}"
            },
            {
              "name": "X-Title",
              "value": "Omnichannel AI Sales Machine"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"model\": {{ JSON.stringify($('⚙️ Config').first().json.model_coder) }},\n  \"temperature\": 0.6,\n  \"max_tokens\": 8000,\n  \"messages\": [\n    { \"role\": \"system\", \"content\": {{ JSON.stringify($json.system_prompt || 'You are a helpful assistant.') }} },\n    { \"role\": \"user\", \"content\": {{ JSON.stringify($json.prompt) }} }\n  ]\n}"
      },
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1640,
        -220
      ],
      "id": "f6059b81-5316-4fac-baa6-4d1d3d189ea7",
      "name": "🧠 Hermes · Generate HTML",
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 5000,
      "onError": "continueRegularOutput"
    },
    {
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const lead = $('🎨 Build Site Prompt').item.json;\nconst ctx  = $('🧾 Normalise Lead').item.json;\n\nlet html = ($json?.choices?.[0]?.message?.content || '').trim();\n\n// strip markdown fences if the model added them anyway\nhtml = html.replace(/^\\`\\`\\`(?:html)?\\s*/i, '').replace(/\\`\\`\\`\\s*$/, '').trim();\n\n// keep only the document itself\nconst start = html.search(/<!DOCTYPE|<html/i);\nif (start > 0) html = html.slice(start);\nconst end = html.toLowerCase().lastIndexOf('</html>');\nif (end !== -1) html = html.slice(0, end + 7);\n\nconst looksValid =\n  html.length > 800 &&\n  /<html[\\s>]/i.test(html) &&\n  /<\\/html>/i.test(html) &&\n  !/\\[business name\\]|lorem ipsum/i.test(html);\n\nif (!looksValid) {\n  throw new Error(\n    `Generated HTML failed validation for \"${ctx.business_name}\" (length ${html.length}). ` +\n    'Try a stronger model in OPENROUTER_MODEL_CODER.'\n  );\n}\n\n// Vercel wants a plain UTF-8 string; slug keeps the project name legal.\nconst slug = (ctx.business_name || 'lead')\n  .toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/^-|-$/g, '').slice(0, 40) || 'lead';\n\nreturn [{\n  json: {\n    ...ctx,\n    html,\n    html_bytes: Buffer.byteLength(html, 'utf8'),\n    project_name: `proto-${slug}-${String(ctx.lead_id).slice(0, 8)}`,\n  },\n}];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1880,
        -220
      ],
      "id": "ddd94881-1fca-4992-a2a7-58244ef2e462",
      "name": "🧽 Extract & Validate HTML"
    },
    {
      "parameters": {
        "method": "POST",
        "options": {
          "timeout": 120000
        },
        "url": "https://api.vercel.com/v13/deployments",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendQuery": true,
        "queryParameters": {
          "parameters": [
            {
              "name": "forceNew",
              "value": "1"
            }
          ]
        },
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"name\": {{ JSON.stringify($json.project_name) }},\n  \"target\": \"production\",\n  \"public\": true,\n  \"files\": [\n    {\n      \"file\": \"index.html\",\n      \"data\": {{ JSON.stringify($json.html) }},\n      \"encoding\": \"utf-8\"\n    }\n  ],\n  \"projectSettings\": {\n    \"framework\": null,\n    \"buildCommand\": null,\n    \"outputDirectory\": null,\n    \"installCommand\": null\n  }\n}"
      },
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        2120,
        -220
      ],
      "id": "fe73bd3f-f89b-4977-9b5e-afe25bb18e0c",
      "name": "▲ Deploy To Vercel",
      "retryOnFail": true,
      "maxTries": 2,
      "waitBetweenTries": 5000
    },
    {
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const ctx = $('🧽 Extract & Validate HTML').item.json;\nconst d = $json || {};\n\n// v13 returns { url: \"proto-x-123.vercel.app\" } (no scheme) plus alias[]\nconst host = d.alias?.[0] || d.url || d.deployment?.url;\nif (!host) throw new Error('Vercel did not return a deployment URL: ' + JSON.stringify(d).slice(0, 400));\n\nconst url = host.startsWith('http') ? host : `https://${host}`;\n\nreturn [{ json: { ...ctx, prototype_url: url, deployment_id: d.id || null } }];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        2360,
        -220
      ],
      "id": "7e040c3a-be03-4a7f-b897-fb1efb896316",
